# Copy to .env and fill in locally. .env is gitignored and must never be committed.

# Email alerts (cry_detection.py). Use a Gmail App Password, not your account password
SENDER_EMAIL=your_gmail@gmail.com
RECEIVER_EMAIL=parent_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Windows remote controller (remote_gui.py)
PI_HOST=192.168.x.x
PI_USER=pi
PI_PASSWORD=your_pi_password
